generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id         String   @id @default(cuid())
  ownerUid   String
  ownerEmail String?
  title      String
  isPublic   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  links      Link[]
  members    BoardMember[]
  invites    BoardInvite[]

  @@index([ownerUid, sortOrder])
  @@index([isPublic, createdAt])
}

model Link {
  id       String  @id @default(cuid())
  boardId  String
  title    String
  url      String
  color    String?
  position Int     @default(0)
  tags     String[] @default([])
  note     String?
  siteTitle String?
  description String?
  previewImageUrl String?
  faviconUrl String?
  board    Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, position])
}

model BoardMember {
  boardId   String
  userUid   String
  email     String
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([boardId, userUid])
  @@index([userUid])
}

model BoardInvite {
  id           String    @id @default(cuid())
  boardId      String
  tokenHash    String    @unique
  invitedByUid String
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  board        Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

}

model UserProfile {
  firebaseUid String   @id
  email       String?
  firstName   String
  lastName    String
  nickname    String?
  displayName String
  updatedAt   DateTime @updatedAt
}
